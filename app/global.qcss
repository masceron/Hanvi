R"(
QWidget {
    background-color: #1e1e1e;
    color: #ffffff;
    font-size: 10pt;
}

QHeaderView::section {
    padding: 4px;
    background-color: #2b2b2b;
}

QPushButton {
    background-color: #2b2b2b;
    border: 1px solid #555555;
    border-radius: 6px;
    padding: 6px 12px;
}
QPushButton:hover {
    background-color: #575757;
}

QPushButton:pressed {
    background-color: #7d7d7d;
}

QPushButton#close_popup {
    background-color: #2b2b2b;
    border: 1px solid #CC5500;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
}

QPushButton:hover#close_popup {
    background-color: #CC5500;
}

QPushButton#delete_node_phrase {
    background-color: #2b2b2b;
    border: 0.5px solid #D22B2B;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
}
QPushButton:hover#delete_node_phrase {
    background-color: #D22B2B;
}
QPushButton#delete_name {
    background-color: #2b2b2b;
    border: 0.5px solid #D22B2B;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
}
QPushButton:hover#delete_name {
    background-color: #D22B2B;
}

QPushButton#edit_set, QPushButton#dump_set, QPushButton#choose_set {
    background-color: #2b2b2b;
    border: 0.5px solid #6164f6;
    font-weight: bold;
}
QPushButton:hover#edit_set, QPushButton#dump_set, QPushButton:hover#choose_set {
    background-color: #6164f6;
}

QPushButton#current_name_set {
    background-color: #2b2b2b;
    font-weight: bold;
    font-family:"Noto Sans SC";
    padding: 4px 8px;
}

QPushButton:hover#current_name_set {
    background-color: #6164f6;
}

QPushButton#delete_set, QPushButton#name_set_choose_none {
    background-color: #2b2b2b;
    border: 0.5px solid #D22B2B;
    font-weight: bold;
}
QPushButton:hover#delete_set, QPushButton:hover#name_set_choose_none {
    background-color: #D22B2B;
}

QPushButton#add_name {
    background-color: #2b2b2b;
    border: 0.5px solid #6164f6;
}
QPushButton:hover#add_name {
    background-color: #6164f6;
}
QPushButton#add_phrase {
    background-color: #2b2b2b;
    border: 0.5px solid #6164f6;
}
QPushButton:hover#add_phrase {
    background-color: #6164f6;
}


QLineEdit, QTextEdit, QPlainTextEdit, TokenCanvas {
    border-style: solid;
    border-color: #2d2d2d;
    border-width: 0 0 2px 0;
    background-color: #2d2d2d;
    border-radius: 4px;
    padding: 4px;
}

TokenCanvas {
    selection-background-color: #214283;
}

QTextBrowser {
    selection-background-color: #214283;
}

QCheckBox:disabled {
    color: #b2beb5;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, TokenCanvas:focus {
    border-color: #61ccff;
}

QSplitter::handle {
    background-color: #1e1e1e;
}
QSplitter::handle:horizontal {
    width: 6px;
}
QSplitter::handle:vertical {
    height: 6px;
}
QSplitter::handle:hover {
    background-color: #383838;
}

QLineEdit#current_page {
    font: 700 12pt "Tahoma";
}

QScrollBar:vertical {
    background: #2b2b2b;
    width: 12px;
}
QScrollBar::handle:vertical {
    background: #555555;
    border-radius: 6px;
}

QProgressBar {
    border: none;
    background: transparent;
    color: white;
    text-align: right;
    font-size: 11pt;
}

QProgressBar::chunk {
    background-color: #6164f6;
    border-radius: 6px;
    margin-top: 20px;
    margin-bottom: 20px;
}

QWidget#tab_container {
    background-color: #1c1b22;
    padding: 0;
    margin: 0;
}

QPushButton#hamburger_btn {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 0;
    margin: 4px 4px 4px 0px;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
}
QPushButton#hamburger_btn:hover {
    background-color: #2b2a33;
}
QPushButton#hamburger_btn:pressed {
    background-color: #42414d;
}

QTabBar {
    background: transparent;
    qproperty-drawBase: 0;
    margin: 0;
    padding: 0;
    border: none;
}

QTabBar::tab {
    background-color: transparent;
    color: #cfcfd8;
    border: none;
    border-radius: 6px;
    padding: 0px 4px 0px 12px;
    margin: 0px 2px 0px 2px;
    min-height: 32px;
    max-height: 32px;
    min-width: 100px;
    max-width: 240px;
    font-size: 9.5pt;
    font-family: "Noto Sans SC", "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI", sans-serif;
}

QTabBar::tab:selected {
    background-color: #42414d;
    color: #ffffff;
}

QTabBar::tab:hover:!selected {
    background-color: #2b2a33;
    color: #ffffff;
}

QToolButton#tab_close_btn {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 0px;
    margin: 0px 4px 0px 8px;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
}

QToolButton#tab_close_btn:hover {
    background-color: #52525e;
}

QToolButton#tab_close_btn:pressed {
    background-color: #5f5e6b;
}

QPushButton#add_tab_btn {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 0;
    margin: 4px 2px 4px 2px;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
}

QPushButton#add_tab_btn:hover {
    background-color: #2b2a33;
}

QPushButton#add_tab_btn:pressed {
    background-color: #42414d;
}

QPushButton#window_min_btn, QPushButton#window_max_btn {
    background-color: transparent;
    border: none;
    border-radius: 0px;
    padding: 0;
    margin: 0;
    min-width: 44px;
    max-width: 44px;
    min-height: 40px;
    max-height: 40px;
}
QPushButton#window_min_btn:hover, QPushButton#window_max_btn:hover {
    background-color: #2b2a33;
}
QPushButton#window_min_btn:pressed, QPushButton#window_max_btn:pressed {
    background-color: #42414d;
}

QPushButton#window_close_btn {
    background-color: transparent;
    border: none;
    border-radius: 0px;
    padding: 0;
    margin: 0;
    min-width: 44px;
    max-width: 44px;
    min-height: 40px;
    max-height: 40px;
}
QPushButton#window_close_btn:hover {
    background-color: #e81123;
}
QPushButton#window_close_btn:pressed {
    background-color: #c40e1d;
}

QTabBar QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    color: #cfcfd8;
    margin: 2px 1px;
}

QTabBar QToolButton:hover {
    background-color: #2b2a33;
}

QMenu {
    background-color: #2b2a33;
    color: #ffffff;
    border: 1px solid #42414d;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #42414d;
}

QMenu::separator {
    height: 1px;
    background-color: #42414d;
    margin: 4px 6px;
}
)"

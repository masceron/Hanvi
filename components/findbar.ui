  <property name="styleSheet">
   <string notr="true">#findbar {
    background-color: #222129;
    border: 1px solid #42414d;
    border-radius: 6px;
}

QLineEdit#search_box,
QLineEdit#lineEdit {
    background-color: #1c1b22;
    border: 1px solid #3c3b46;
    border-radius: 4px;
    color: #ffffff;
    padding: 0px 6px;
    font-size: 10pt;
    min-height: 22px;
    max-height: 22px;
    selection-background-color: #214283;
}
QLineEdit#search_box:focus,
QLineEdit#lineEdit:focus {
    border: 1px solid #61ccff;
}

QLabel#matches {
    background: transparent;
    color: #9a9aa6;
    font-size: 9pt;
    font-family: &quot;Segoe UI&quot;, &quot;Tahoma&quot;, sans-serif;
    padding: 0px 4px;
    min-height: 24px;
    max-height: 24px;
}

QPushButton#previous_match,
QPushButton#next_match {
    background-color: #2b2a33;
    border: 1px solid #42414d;
    border-radius: 4px;
    padding: 0px;
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
    color: #cfcfd8;
    font-size: 8pt;
}
QPushButton#previous_match:hover,
QPushButton#next_match:hover {
    background-color: #42414d;
    color: #ffffff;
}
QPushButton#previous_match:pressed,
QPushButton#next_match:pressed {
    background-color: #52515e;
}
QPushButton#previous_match:disabled,
QPushButton#next_match:disabled {
    background-color: #1e1e24;
    border-color: #2b2a33;
    color: #555560;
}

QPushButton#search_button,
QPushButton#pushButton {
    background-color: #2b2b36;
    border: 1px solid #6164f6;
    border-radius: 4px;
    padding: 0px 10px;
    min-height: 22px;
    max-height: 22px;
    color: #ffffff;
    font-weight: bold;
    font-size: 9pt;
}
QPushButton#search_button:hover,
QPushButton#pushButton:hover {
    background-color: #6164f6;
}
QPushButton#search_button:pressed,
QPushButton#pushButton:pressed {
    background-color: #4b4ec4;
}

QPushButton#close {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 0px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    color: #9a9aa6;
    font-size: 10pt;
}
QPushButton#close:hover {
    background-color: #e81123;
    color: #ffffff;
}
QPushButton#close:pressed {
    background-color: #c40e1d;
    color: #ffffff;
}</string>
